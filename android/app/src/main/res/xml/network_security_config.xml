<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config — allows cleartext (plain TCP/UDP) traffic
  on the local network for device discovery and file transfer.
  LAN-only: ZoroBeam never routes file data through the internet.
-->
<network-security-config>
    <!-- Allow cleartext for local subnet addresses -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>

    <!-- All other traffic uses system default (HTTPS only) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
